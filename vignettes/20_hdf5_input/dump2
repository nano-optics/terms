           def mesh_data(fobj, meshfile, lunit="m"):
               if isinstance(meshparser, ImportError):
                   return
               print(type(meshfile), "meshtype", isinstance(meshfile, meshparser.Mesh))
               if isinstance(meshfile, str):
                   mesh = meshparser.Mesh.read(meshfile)
               
