               """Calculate the maximal and minimal coordinate value for each direction.
           
               If the list is empty return zeros.
           
               Args:
                   nodes (Iterable): list of nodes
           
               Returns:
                   tuple
               """
               if not nodes:
                   return [0, 0, 0], [0, 0, 0]
               cmin = [float("inf")] * 3
               cmax = [float("-inf")] * 3
               for node in nodes:
                   for i in range(3):
                       cmin[i] = min((node.in_3d[i], cmin[i]))
                       cmax[i] = max((node.in_3d[i], cmax[i]))
               return cmin, cmax
           
           
