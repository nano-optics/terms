                   "$PhysicalNames",
                   "$Entities",
                   "$Nodes",
                   "$Elements",
               ]
               itr = _iter_wo_comments(fobj, "//")
               mode = None
               for line in itr:
                   if mode is None and line.startswith("$"):
                       mode = line
                   if mode in modes:
                       yield line
                   if mode is not None and line == "$End" + mode[1:]:
                       mode = None
           
           
