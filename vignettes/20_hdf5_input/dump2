           class Quadrilateral(Element):
               """Four nodes in a plane.
           
               The order of the nodes is different in different programs. In JCMsuite and gmsh they
               are in clockwise order, in COMSOL the last two nodes are exchanged.
               """
           
               dim = 2
               n_nodes = 4
               gmsh_type = 3
               comsol_name = "4 quad"
               jcm_short_name = "#Q"
           
           
